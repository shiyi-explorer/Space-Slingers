  "_design_notes": {
    "angle_convention": "0°=行星朝向 +X（远离弹弓的背面）；±180°=朝向弹弓的近侧；-90°=行星顶部。球面法线 (cos lat·cos angle, sin lat, cos lat·sin angle)。",
    "hut_geometry": "掩体三件套=两根立柱（radial，w14×h50，lift 0，angle=猪±Δ）+ 横梁屋顶（tangent）。几何推导：柱顶中心的径向投影=(r+50)·cos Δ，屋顶 lift = 50−(r+50)(1−cos Δ)+2.5。关键坑：柱顶面与屋顶面相差 Δ 角，柱顶外角比中心高出 7·sin Δ≈1.7px——lift 不加这 2~2.5px 余量，2D 求解器只会把屋顶温和抬起（无感），3D 求解器却会选切向去穿插把屋顶侧踢下柱顶（L4 塌顶的根因）。屋顶长度 L ≈ 2(r+50)·sin Δ + 14；按行星半径选 Δ：r150→14°、r140→14°、r135→14°、r125→16°。猪顶（r+42）与屋顶底面留 ≥4px。叠放（石板压木梁）：两者同 angle 同法线，lift 直接相加无需角隙修正。",
    "design_pillars": "每关一个核心问题：L1 直射+弧线入门 / L2 背面绕行 / L3 穿缝+分裂双杀 / L4 卫星引力弹射 / L5 材质弱点（玻璃支柱）+塔塌压杀 / L6 综合考试。材质=难度旋钮（玻璃白给、木需实射、石需加速鸟或找弱点）；特殊鸟必须有专属用途（L3/L6 分裂齐射、L5 石墙加速鸟）；高纬猪只做裸置（掩体几何在球面上按 cos lat 缩放，不在高纬搭屋）。",
    "star_economy": "maxScore=猪×5000+方块分值+残余鸟×(birds−1)×10000（后端按同公式预存校验）。starThresholds 三档按本关 maxScore 的 ~30%/60%/80% 推导；≤2 发通关另直接给三星。",
    "reachability": "改关卡/改引力后必跑 tests/reachability_check_2d.gd 与 tests/reachability_check.gd：每只猪都必须存在几何可达且动量足够的直击弹道；tests/structure_check.gd 验证掩体开局静置不塌。"
  }
}
